TELEGRAM_TOKEN=123456:ABC-your-token-from-botfather
TELEGRAM_CHAT_ID=123456789
DB_PATH=./seen.db
POLL_INTERVAL=1800

# Dashboard. Unset means no listener at all, which is what you want locally -
# use `dashboard.py --serve` on demand instead. fly.toml sets it to 8080
# because Fly needs something bound to internal_port. The dashboard has no
# auth, so do not set this on a host you would not want serving the corpus.
# DASHBOARD_PORT=8080
