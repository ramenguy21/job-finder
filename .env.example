TELEGRAM_TOKEN=123456:ABC-your-token-from-botfather
TELEGRAM_CHAT_ID=123456789
DB_PATH=./seen.db
POLL_INTERVAL=1800

# Dashboard. Unset DASHBOARD_PORT means no listener at all, which is what you
# want locally - use `dashboard.py --serve` on demand instead. fly.toml sets it
# to 8080 because Fly needs something bound to internal_port.
# DASHBOARD_PORT=8080
# Without a token the dashboard serves 503 instead of publishing the corpus.
# On Fly this is a secret, never an [env] entry: `fly secrets set DASHBOARD_TOKEN=...`
# DASHBOARD_TOKEN=generate-with-openssl-rand-hex-24
